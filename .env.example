# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=postgresql+psycopg://video_os:REPLACE_WITH_LOCAL_SECRET@127.0.0.1:54329/video_os
STORAGE_DIR=./runtime/storage

# Production hardening (set when deploying online)
# APP_ENV=production        # secure cookies, HSTS, API docs hidden
# COOKIE_SECURE=true
# TRUST_PROXY=true          # only behind a reverse proxy you control

# Optional Unicode font for PDF export:
# PDF_FONT_PATH=C:/Windows/Fonts/arial.ttf
